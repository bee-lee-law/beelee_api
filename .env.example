# Server Configuration
PORT=8888
NODE_ENV=development

# API Keys (add your keys here)
MAPBOX_API_KEY=your_mapbox_api_key_here
# OSM_API_KEY=your_osm_api_key_here
# COLLISION_API_KEY=your_collision_api_key_here

# CORS Configuration (comma-separated origins for production)
# CORS_ORIGINS=https://yourdomain.com

# JWT Configuration
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Token Encryption (for storing OAuth tokens at rest)
TOKEN_ENCRYPTION_KEY=your_32_char_encryption_key_here

# Owner Mode Password
# Generate hash with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 12))"
OWNER_PASSWORD_HASH=your_bcrypt_hash_here

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
DYNAMODB_TABLE_PREFIX=beelee_

# Challonge OAuth
CHALLONGE_CLIENT_ID=your_challonge_client_id
CHALLONGE_CLIENT_SECRET=your_challonge_client_secret
CHALLONGE_REDIRECT_URI=http://localhost:8888/api/auth/oauth/callback
